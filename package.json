{
  "name": "registro-proveedor-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node ./node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "dev:web": "node ./node_modules/@angular/cli/bin/ng.js serve --proxy-config proxy.conf.json",
    "build": "node ./node_modules/@angular/cli/bin/ng.js build",
    "demo": "node ./node_modules/tsx/dist/cli.mjs demo.ts",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "express": "^5.1.0",
    "pdfkit": "^0.17.2",
    "rxjs": "^7.8.2",
    "serverless-http": "^4.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "@types/pdfkit": "^0.17.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "~5.9.2"
  }
}
